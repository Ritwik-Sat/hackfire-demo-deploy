{
    "name": "hackfire",
    "version": "1.0.0",
    "description": "Multi-hackathon management system",
    "scripts": {
        "start": "node backend/src/server.js",
        "dev": "concurrently -n \"backend,frontend\" -c \"blue,magenta\" \"npm run backend-dev\" \"npm run frontend-dev\"",
        "build": "npm run install-all",
        "backend-dev": "npm --prefix backend run dev",
        "frontend-dev": "npm --prefix frontend run dev",
        "install-all": "npm install --prefix backend --include=dev && npm install --prefix frontend --include=dev"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "dependencies": {
        "cloudinary": "^2.9.0",
        "concurrently": "^9.2.1",
        "fs": "^0.0.1-security",
        "pdf-lib": "^1.17.1",
        "qrcode": "^1.5.4",
        "streamifier": "^0.1.1"
    },
    "devDependencies": {
    },
    "overrides": {
        "@react-three/drei": "^9.102.1",
        "@react-three/fiber": "^8.17.10"
    }
}